# Frontend environment (all optional).
#
# By default the app calls the API on the same origin ("/api/v1"):
#   - in development, Vite proxies /api to the Spring Boot backend (see vite.config.js)
#   - on Vercel, vercel.json rewrites /api to the deployed backend
#   - inside the Spring Boot jar, the API and the app share one server
#
# Only set this to point a build at a different backend, which then needs CORS enabled
# via CORS_ALLOWED_ORIGINS on the server:
# VITE_API_BASE_URL=https://your-backend.example.com/api/v1

# Dev server only: where Vite forwards /api (default http://localhost:8080)
# BACKEND_URL=http://localhost:8080
