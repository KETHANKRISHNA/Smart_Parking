# ==========================================
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# Active Profile: dev (H2 MySQL-mode persistent DB) or mysql (MySQL 8.0)
SPRING_PROFILES_ACTIVE=dev

# MySQL Configuration (Active only when SPRING_PROFILES_ACTIVE=mysql)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_parking_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JWT Secret Key (HMAC-SHA256, minimum 256 bits)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Server Port
SERVER_PORT=8080

# CORS Whitelist
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
