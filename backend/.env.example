# Backend configuration. Spring Boot reads these from the process environment (it does not load .env files itself:
# export them, set them in your IDE run configuration, or put them in your hosting dashboard).
#
# Local development needs NONE of these: the default "dev" profile uses a file-based H2 database, seeds demo data
# and has a built-in development-only signing key.

# --- Production (SPRING_PROFILES_ACTIVE=prod) ----------------------------------------------------
SPRING_PROFILES_ACTIVE=prod

# Signing key for login tokens: at least 32 random characters. REQUIRED. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# PostgreSQL: either one JDBC URL ...
# DATABASE_URL=jdbc:postgresql://localhost:5432/smartparking
# ... or host/name (port defaults to 5432)
DB_HOST=localhost
DB_NAME=smartparking
DATABASE_USERNAME=smartparking
DATABASE_PASSWORD=

# First administrator for an empty database (created at startup if no admin exists yet)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Optional ------------------------------------------------------------------------------------
# Load sample facilities + demo accounts (documented passwords: only for presentations)
SEED_DEMO_DATA=false
# Browser origins allowed to call the API directly (not needed behind the Vercel proxy or the bundled jar)
CORS_ALLOWED_ORIGINS=
# Serve Swagger UI at /swagger-ui.html (always on in dev)
SWAGGER_ENABLED=false
# Business rules
BOOKING_PAYMENT_WINDOW_MINUTES=15
BOOKING_ENTRY_GRACE_MINUTES=15
APP_TIME_ZONE=Asia/Kolkata
AUTH_RATE_LIMIT_PER_MINUTE=20
