# Active Profile: dev (H2 zero-config file mode) or mysql (Production MySQL 8.0)
SPRING_PROFILES_ACTIVE=dev

# Server Port
SERVER_PORT=8080

# MySQL Database Configuration (when SPRING_PROFILES_ACTIVE=mysql)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_parking_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8080/api/v1
